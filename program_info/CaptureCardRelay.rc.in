#ifndef WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#endif
#include <windows.h>

IDI_ICON1               ICON    DISCARDABLE     "@App_Branding_ICO@"
1 RT_MANIFEST "@App_CommonName@.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @App_VERSION_NAME4_COMMA@
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
        BLOCK "StringFileInfo"
        BEGIN
                BLOCK "000004b0"
                BEGIN
                        VALUE "CompanyName", "@App_Authors@"
                        VALUE "FileDescription", "@App_DisplayName@"
                        VALUE "FileVersion", "@App_VERSION_NAME4@"
                        VALUE "ProductName", "@App_DisplayName@"
                        VALUE "ProductVersion", "@App_VERSION_NAME4@"
                END
        END
        BLOCK "VarFileInfo"
        BEGIN
                VALUE "Translation", 0x0000, 0x04b0 // Unicode
        END
END